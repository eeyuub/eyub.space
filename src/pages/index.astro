---
import H1 from "../components/h1.astro";
import Link from "../components/link.astro";
import Navigation from "../components/navigation";
import RootLayout from "../layouts/RootLayout.astro";
import WarpBackground from "../components/warp-background";
import AvailableForWork from "../components/available.astro";
import resume from "../data/resume.json";
const randomTitles = [...resume.professionalTitles].sort(() => Math.random() - 0.5).slice(0, 4);
---

<RootLayout>
	<main>
		<div class="group relative w-full min-h-dvh flex items-center justify-center">
			<div class="absolute w-full h-dvh -z-10">
				<WarpBackground
					color1="#09090b"
					color2="#27272a"
					color3="#52525b"
					speed={0.6}
					swirl={0.5}
					swirlIterations={10}
					shapeScale={0.3}
					client:load
				/>
			</div>

			<div class="p-4 sm:p-8 absolute w-full h-dvh flex flex-col justify-between z-10">
				<div>
					<H1 size="large" className="uppercase"> {resume.basics.firstName} <br /> {resume.basics.lastName} </H1>

					<div class="mt-3 sm:mt-5 flex flex-wrap gap-2">
						{randomTitles.map((tag) => (
							<span class="rounded-full border border-zinc-700/60 bg-zinc-800/60 px-3 py-1 text-xs sm:text-sm text-zinc-300">
								{tag}
							</span>
						))}
					</div>
				</div>

				<div>
					<AvailableForWork className="py-4" />
					<div class="mb-2 sm:mb-4 flex items-center justify-between">
						<div class="flex items-center gap-4">
							<Link href={`tel:${resume.basics.phone.replace(/\s+/g, '')}`}>Book a call</Link>
							<Link href="/projects" variant="secondary">View recent work</Link>
						</div>

						<Navigation client:load>
							<Link href="/about" variant="secondary">About</Link>
							<Link href="/contact" variant="secondary">Contact</Link>
						</Navigation>
					</div>
				</div>
			</div>
		</div>
	</main>
</RootLayout>
