---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import resume from "../../public/resume.json";
const projects = resume.projects;
---

<InfoLayout>
     <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh">
          <H1> Projects </H1>

          <ul class="mt-4 sm:mt-12 grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-16 sm:gap-8">
               {projects.map((project) => (
                    <li>
                         <a href={project.url} target="_blank" rel="noopener noreferrer" class="group block">
                              <img src={project.thumbnail || project.logo} alt={project.name} class="aspect-[1/1.33] w-full object-center object-cover rounded-lg shadow-lg mb-4 sm:mb-0 sm:mr-4" />
                              <div class="p-1 sm:p-2">
                                   <h2 class="text-base text-zinc-100 group-hover:underline group-hover:decoration-zinc-500 group-hover:underline-offset-4">{project.name}</h2>
                                   <p class="text-sm text-zinc-400 text-balance">{project.description}</p>
                              </div>
                         </a>
                    </li>
               ))}
          </ul>
     </div>
</InfoLayout>