---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import resume from "../data/resume.json";
const projects = resume.projects;
---

<InfoLayout>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh">
    <H1> Projects </H1>

    <ul
      class="mt-4 sm:mt-12 grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-16 sm:gap-8"
    >
      {
        projects.map((project) => (
          <li>
            <div>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block relative"
              >
                <img
                  src={`/api/project-image?url=${encodeURIComponent(project.thumbnail || project.logo)}`}
                  alt={project.name}
                  class="aspect-[1/1.33] w-full object-center object-cover rounded-lg shadow-lg"
                />
                <div class="absolute inset-0 hidden items-center justify-center rounded-lg bg-zinc-900/80 p-4 text-center opacity-0 backdrop-blur-sm transition-all group-hover:opacity-100 lg:flex">
                  <p class="text-sm text-zinc-400 text-balance">
                    {project.description}
                  </p>
                </div>
              </a>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-center"
              >
                <h3 class="mt-2 text-base text-zinc-100 hover:underline hover:decoration-zinc-500 hover:underline-offset-4">
                  {project.name}
                </h3>
              </a>
              <p class="mt-1 text-sm text-zinc-400 text-balance lg:hidden text-center">
                {project.description}
              </p>
            </div>
          </li>
        ))
      }
      <li>
        <a href="/contact">
          <div
            class="aspect-[1/1.33] w-full rounded-lg shadow-lg border-2 border-dashed border-zinc-700 bg-zinc-800/50 flex items-center justify-center p-4"
          >
            <h3
              class="flex items-center justify-center gap-2 text-center text-base text-zinc-100"
            >
              your project here
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-5 text-red-500"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
                ></path>
              </svg>
            </h3>
          </div>
        </a>
      </li>
    </ul>
  </div>
</InfoLayout>
